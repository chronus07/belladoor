rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Coleção oficial de produção (isolada de versões antigas em cache)
    match /belladoor_prod/{docId} {
      allow read, write: if true;
    }
    match /belladoor/{docId} {
      allow read, write: if true;
    }
  }
}
