# ==============================================================================
# BELLADOOR - VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env ao conectar com banco em produção (Supabase)
# ==============================================================================

# Supabase (Banco de Dados PostgreSQL e Login gratuito)
VITE_SUPABASE_URL=https://sua-url-do-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anonima

# URLs da Aplicação
VITE_APP_URL=https://belladoor.app

# Integração de Pagamento (Asaas ou Mercado Pago)
VITE_PAYMENT_GATEWAY=ASAAS
ASAAS_API_KEY=sua_chave_de_api_asaas
